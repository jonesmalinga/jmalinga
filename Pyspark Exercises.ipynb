# 1. How many rows of the EU Superstore dataset have the country being France?
france_count = df.filter(df.Country == "France").count()
print(f"Number of rows with country France: {france_count}")

# 2. Of those, how many are profitable?
france_profitable = df.filter((df.Country == "France") & (df.Profit > 0)).count()
print(f"Number of profitable France rows: {france_profitable}")

# 3. How many different discount brackets exist? What are they?
discount_brackets = df.select("Discount").distinct().orderBy("Discount").collect()
print(f"Number of discount brackets: {len(discount_brackets)}")
print("Discount brackets:", [row.Discount for row in discount_brackets])

# 4. Let's see the total profit by discount bracket, make sure they are ordered by profit
profit_by_discount = df.groupBy("Discount").agg(
    {"Profit": "sum"}
).withColumnRenamed("sum(Profit)", "Total_Profit").orderBy("Total_Profit", ascending=False)
profit_by_discount.show()

# 5. What is the value after which we should stop offering discount?
# Looking at profit by discount to see where profit becomes negative
profit_by_discount.orderBy("Discount").show()

# 6. Who are the top 5 most profitable customers?
top_customers = df.groupBy("Customer Name").agg(
    {"Profit": "sum"}
).withColumnRenamed("sum(Profit)", "Total_Profit").orderBy("Total_Profit", ascending=False).limit(5)
top_customers.show()

# 7. Get all the rows belonging to those 5 customer names
top_customer_names = [row["Customer Name"] for row in top_customers.collect()]
customer_rows = df.filter(df["Customer Name"].isin(top_customer_names))
print(f"Number of rows for top 5 customers: {customer_rows.count()}")
customer_rows.show()

# 8. Create a new column which is the value of the sale were there not discount applied
from pyspark.sql.functions import col, round
df_with_original = df.withColumn("Original_Sales", 
                                 round(col("Sales") / (1 - col("Discount")), 2))
df_with_original.show(5)

# 9. Calculate the difference between sales and discount value
df_with_discount_value = df_with_original.withColumn(
    "Discount_Amount", 
    round(col("Original_Sales") - col("Sales"), 2)
)
df_with_discount_value.show(5)

# 10. How much money did we not gain due to the discounts - per discount bracket?
lost_revenue_by_discount = df_with_discount_value.groupBy("Discount").agg(
    {"Discount_Amount": "sum"}
).withColumnRenamed("sum(Discount_Amount)", "Total_Discount_Given").orderBy("Discount")
lost_revenue_by_discount.show()

# 11. Find the discount bracket which made us not gain the most (dynamically)
max_loss_discount = lost_revenue_by_discount.orderBy("Total_Discount_Given", ascending=False).first()
print(f"Discount bracket with highest loss: {max_loss_discount['Discount']} with total discount of {max_loss_discount['Total_Discount_Given']}")

# 12. What would have been the total profit if we removed all orders from that discount group?
max_loss_discount_value = max_loss_discount['Discount']
current_total_profit = df.agg({"Profit": "sum"}).collect()[0][0]
filtered_profit = df.filter(col("Discount") != max_loss_discount_value).agg(
    {"Profit": "sum"}
).collect()[0][0]

print(f"Current total profit: {current_total_profit}")
print(f"Profit without {max_loss_discount_value} discount bracket: {filtered_profit}")

# 13. How much more (or less) profit is that?
profit_difference = filtered_profit - current_total_profit
print(f"Profit difference: {profit_difference}")

# 14. Create a temporary table for our superstore table in sql
df.createOrReplaceTempView("superstore")

# 15. Use an SQL query to count the number of rows
row_count = spark.sql("SELECT COUNT(*) as row_count FROM superstore").show()

# 16. Use an SQL query to calculate the profit ratio for each country
profit_ratio = spark.sql("""
    SELECT Country, 
           SUM(Profit) as Total_Profit, 
           SUM(Sales) as Total_Sales,
           ROUND(SUM(Profit)/SUM(Sales), 4) as Profit_Ratio
    FROM superstore 
    GROUP BY Country 
    ORDER BY Profit_Ratio DESC
""")
profit_ratio.show()

# 17. Is the country with the largest profit ratio, the country with the largest profit?
# Get country with largest profit ratio
largest_ratio_country = profit_ratio.orderBy("Profit_Ratio", ascending=False).first()
print(f"Country with largest profit ratio: {largest_ratio_country['Country']} with ratio {largest_ratio_country['Profit_Ratio']}")

# Get country with largest profit
largest_profit_country = profit_ratio.orderBy("Total_Profit", ascending=False).first()
print(f"Country with largest profit: {largest_profit_country['Country']} with profit {largest_profit_country['Total_Profit']}")

# Compare
if largest_ratio_country['Country'] == largest_profit_country['Country']:
    print("The country with the largest profit ratio is the same as the country with the largest profit")
else:
    print("The country with the largest profit ratio is NOT the same as the country with the largest profit") 
